     return $?
 }
 
-if _is_lto_kernel && [ "$_use_lto_suffix" = "yes"  ]; then
-    _pkgsuffix=cachyos-lto
-elif ! _is_lto_kernel && [ "$_use_gcc_suffix" = "yes" ]; then
-    _pkgsuffix=cachyos-gcc
-else
-    _pkgsuffix=cachyos
+# Allow export _pkgsuffix=appsynergy-server-ovh|nuc|appsynergy|… before makepkg.
+if [ -z "${_pkgsuffix:-}" ]; then
+    if _is_lto_kernel && [ "$_use_lto_suffix" = "yes"  ]; then
+        _pkgsuffix=cachyos-lto
+    elif ! _is_lto_kernel && [ "$_use_gcc_suffix" = "yes" ]; then
+        _pkgsuffix=cachyos-gcc
+    else
+        _pkgsuffix=cachyos
+    fi
 fi
 
