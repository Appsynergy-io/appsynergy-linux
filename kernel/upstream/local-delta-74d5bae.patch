+# --- appsynergy skylake fragment ---
+# server-skylake.fragment — MAX performance kernel for server1 (E3-1270 v6) only
+# Host: Xeon E3-1270 v6 (Skylake-S, 4c/8t) · 32 GiB · 2× I210 (igb) · dual NVMe · UEFI
+# Package: linux-appsynergy-server-skylake  (uname …-appsynergy-server-skylake)
+# ISA: -march=skylake via build script KCFLAGS (NOT X86_NATIVE on build host)
+#
+# Do not boot this package on Tiger Lake NUC or desktop 12900K.
+# Merge onto Cachy config, then olddefconfig inside makepkg prepare.
+
+CONFIG_LOCALVERSION=""
+# CONFIG_LOCALVERSION_AUTO is not set
+
+# Portable baseline Kconfig; actual codegen is skylake via KCFLAGS (see build script).
+# PKGBUILD must set _processor_opt=generic_v3 so prepare does NOT re-enable NATIVE.
+CONFIG_GENERIC_CPU=y
+CONFIG_X86_64_VERSION=3
+# CONFIG_X86_NATIVE_CPU is not set
+# CONFIG_MNATIVE_INTEL is not set
+# CONFIG_MNATIVE_AMD is not set
+# CONFIG_MZEN4 is not set
+
+# 4c/8t Xeon — tiny NR_CPUS cuts per-CPU data
+CONFIG_NR_CPUS=16
+# CONFIG_MAXSMP is not set
+# Single-socket; no NUMA balancing
+# CONFIG_NUMA is not set
+# CONFIG_NUMA_BALANCING is not set
+
+CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
+CONFIG_LTO_CLANG_THIN=y
+# CONFIG_LTO_CLANG_FULL is not set
+CONFIG_AUTOFDO_CLANG=y
+
+# Intel-only SKU
+CONFIG_CPU_SUP_INTEL=y
+# CONFIG_CPU_SUP_AMD is not set
+# CONFIG_CPU_SUP_HYGON is not set
+# CONFIG_CPU_SUP_CENTAUR is not set
+# CONFIG_CPU_SUP_ZHAOXIN is not set
+CONFIG_X86_INTEL_PSTATE=y
+# CONFIG_X86_AMD_PSTATE is not set
+# CONFIG_AMD_MEM_ENCRYPT is not set
+
+# Scheduler / tick — tunnel throughput
+CONFIG_PREEMPT=y
+CONFIG_PREEMPT_DYNAMIC=y
+CONFIG_HZ_250=y
+# CONFIG_HZ_1000 is not set
+CONFIG_HZ=250
+CONFIG_SCHED_CLASS_EXT=y
+# CONFIG_SCHED_AUTOGROUP is not set
+CONFIG_SCHED_CORE=y
+CONFIG_SCHED_SMT=y
+CONFIG_SCHED_MC=y
+# CONFIG_SCHED_CLUSTER is not set
+CONFIG_RCU_BOOST=y
+CONFIG_RCU_NOCB_CPU=y
