CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_TUNNEL=m
CONFIG_NFT_QUEUE=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_FIB=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_NETDEV=m
CONFIG_NFT_SOCKET=m
CONFIG_NFT_OSF=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SYNPROXY=m
CONFIG_NFT_DUP_NETDEV=m
CONFIG_NFT_FWD_NETDEV=m
CONFIG_NF_FLOW_TABLE=m
CONFIG_NF_FLOW_TABLE_INET=m
CONFIG_NFT_FLOW_OFFLOAD=m
CONFIG_NETFILTER_XTABLES=m

CONFIG_WIREGUARD=y
CONFIG_TUN=y
CONFIG_VETH=m
CONFIG_IPVLAN=m
CONFIG_MACVLAN=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_FOU=m
CONFIG_IP_GRE=m
CONFIG_IPV6_GRE=m
CONFIG_NET_IPIP=m
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_BRIDGE=m
# Built in, not a module: the k3s site's LAN perimeter is a host nftables
# ruleset on the `forward` hook (nuc-k3s network/netguard.nft, rendered from
# apps/exposure-lab.toml). Multus puts each public workload's veth on br-pub
# with the uplink enslaved, so LAN → Pod traffic is *bridged*; without
# bridge netfilter those frames never reach a netfilter hook and the ruleset
# loads clean while filtering nothing. Measured 2026-08-02: with this unset,
# .120/.199/.251/.252 answer on every port their images bind.
#
# It also removes the reason prod needs `masquerade-all=true` in kube-proxy —
# a Service VIP reply that is bridged peer-to-peer is never un-DNATed and the
# client discards it. Keep masquerade-all until that is re-measured here.
#
# Requested as =y; Kconfig resolves it to =m because CONFIG_BRIDGE=m above and
# a symbol cannot be built in when its dependency is modular. That is fine, but
# it means the perimeter now depends on the module being loaded: nftables will
# accept the ruleset whether or not br_netfilter is present, and silently
# filter nothing until it is. scripts/modules-load-server.conf loads only
# nf_conntrack and nf_tables, so nuc-k3s ships its own modules-load.d and
# sysctl.d drop-ins and install-netguard.sh refuses without them.
# Set CONFIG_BRIDGE=y as well if you ever want this genuinely built in.
CONFIG_BRIDGE_NETFILTER=y
# Conntrack for bridged frames — `ct state established,related accept` in the
# guard is meaningless without it.
CONFIG_NF_CONNTRACK_BRIDGE=m

