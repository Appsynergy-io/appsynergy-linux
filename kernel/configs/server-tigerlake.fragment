# server-tigerlake.fragment — MAX performance kernel for lab Tiger Lake only
# Host: i7-1185G7 (Tiger Lake, 4c/8t) · I225-LM (igc) · Samsung 980 PRO NVMe · UEFI
# Probe: root@192.168.101.101
# Package: linux-appsynergy-server-tigerlake  (uname …-appsynergy-server-tigerlake)
# ISA: -march=tigerlake via build script KCFLAGS (NOT X86_NATIVE on build host)
#
# Do not boot this package on OVH E3-1270 v6 or desktop 12900K.
# Server profile: no Wi-Fi/BT/GPU/audio even though NUC silicon has them.

CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# Portable baseline Kconfig; actual codegen is tigerlake via KCFLAGS.
# PKGBUILD must set _processor_opt=generic_v3 so prepare does NOT re-enable NATIVE.
CONFIG_GENERIC_CPU=y
CONFIG_X86_64_VERSION=3
# CONFIG_X86_NATIVE_CPU is not set
# CONFIG_MNATIVE_INTEL is not set
# CONFIG_MNATIVE_AMD is not set
# CONFIG_MZEN4 is not set

# 4c/8t Tiger Lake
CONFIG_NR_CPUS=16
# CONFIG_MAXSMP is not set
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set

CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_AUTOFDO_CLANG=y

CONFIG_CPU_SUP_INTEL=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
CONFIG_X86_INTEL_PSTATE=y
# CONFIG_X86_AMD_PSTATE is not set
# CONFIG_AMD_MEM_ENCRYPT is not set

CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_250=y
