CONFIG_HZ=250
CONFIG_SCHED_CLASS_EXT=y
# CONFIG_SCHED_AUTOGROUP is not set
CONFIG_SCHED_CORE=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
# CONFIG_SCHED_CLUSTER is not set
CONFIG_RCU_BOOST=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_LAZY=y
# CONFIG_NO_HZ_FULL is not set
CONFIG_NO_HZ_IDLE=y
CONFIG_IRQ_TIME_ACCOUNTING=y

CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
