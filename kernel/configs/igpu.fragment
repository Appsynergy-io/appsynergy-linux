# rustopt.fragment — merge onto CachyOS running config (i9-12900K desktop)
# Verified against live scan 2026-07-12. Apply:
#   scripts/kconfig/merge_config.sh -m .config rustopt.fragment && make LLVM=1 olddefconfig
#
# Machine: ASUS Z690, i9-12900K, RTX 4090 only (no iGPU in DRM), NVMe under VMD,
# LUKS+btrfs root, I225-V, AX210, USB audio + NVIDIA HDMI audio, Docker, KDE.
#
# TIER A = real runtime/cache benefit on this box
# TIER B = size/safety cleanups, small or indirect benefit
# TIER C = do not touch without extra verification

# =============================================================================
# TIER A — high confidence wins
# =============================================================================

# Suffix comes from the PKGBUILD's localversion.20-pkgname (-cachyos-rustopt);
# a value here would double-append.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# Native Alder Lake codegen (currently GENERIC_CPU + x86-64-v3 on Cachy package)
# CONFIG_GENERIC_CPU is not set
CONFIG_X86_NATIVE_CPU=y

# 24 logical CPUs — 8192 wastes static per-CPU footprint
CONFIG_NR_CPUS=64
# CONFIG_MAXSMP is not set

# Single-socket desktop: NUMA topology still exists in ACPI tables on many boards;
# keep NUMA=y for correctness, shrink node shift (was 10 → 1024 nodes)
CONFIG_NUMA=y
CONFIG_NODES_SHIFT=3
# CONFIG_AMD_NUMA is not set
# NUMA balancing on 1 node is pure overhead for migration attempts
# CONFIG_NUMA_BALANCING is not set

CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
CONFIG_AUTOFDO_CLANG=y

CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_SCHED_CORE=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_SCHED_CLUSTER=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_LAZY=y

# NO_HZ_FULL without isolcpus/nohz_full= on cmdline does nothing useful here
# (current cmdline has neither). Prefer idle tickless for desktop.
# CONFIG_NO_HZ_FULL is not set
CONFIG_NO_HZ_IDLE=y

CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_HUGETLBFS=y

# Active LSMs only: capability,landlock,lockdown,yama,bpf
# SELinux/Smack/Tomoyo/AppArmor are compiled in Cachy but NOT active — drop hooks/code
CONFIG_LSM="landlock,lockdown,yama,bpf"
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_BPF_LSM=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CPU_MITIGATIONS=y

# In-kernel Rust: no Rust drivers used on this box (no nova; binder is the C
# impl). Irrelevant to userspace cargo perf; drops rust-bindgen/rust-src deps.
# CONFIG_RUST is not set

# DWARF5 stays like stock: DEBUG_INFO_BTF and SCHED_CLASS_EXT depend on
# DEBUG_INFO, and the package strips debug info from installed artifacts anyway.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_KFENCE is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_FTRACE_SYSCALLS is not set
# CONFIG_DYNAMIC_DEBUG is not set

# CPU vendor: Intel host only (never boot this image on AMD)
CONFIG_CPU_SUP_INTEL=y
# CONFIG_CPU_SUP_AMD is not set
# CONFIG_CPU_SUP_HYGON is not set
# CONFIG_CPU_SUP_CENTAUR is not set
# CONFIG_CPU_SUP_ZHAOXIN is not set
CONFIG_X86_INTEL_PSTATE=y
# CONFIG_X86_AMD_PSTATE is not set
# CONFIG_X86_MCE_AMD is not set
# CONFIG_AMD_MEM_ENCRYPT is not set

# GPU: NVIDIA card dead/removed 2026-07-19. Intel UHD 770 (Alder Lake-S, i915) is now
# the only GPU. i915 BUILT-IN (=y) so KMS + fbcon + login come up with zero initramfs
# dependency — the boot-to-login path must never rely on a module being pulled in.
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_I915=y
# CONFIG_DRM_XE is not set
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set

# =============================================================================
# TIER A/B — boot path (DO NOT disable)
# =============================================================================

CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_VMD=y
CONFIG_SATA_AHCI=m
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_BUFIO=m
# dm_verity is loaded with use-count 0 — not on root path; keep as m if something pulls it
CONFIG_DM_VERITY=m
# CONFIG_MD is the whole RAID/LVM menu that BLK_DEV_DM/DM_CRYPT (LUKS root!)
# depend on — must stay y. Only the md-RAID array driver is dropped.
CONFIG_MD=y
# CONFIG_BLK_DEV_MD is not set
CONFIG_BLK_DEV_LOOP=m
# CONFIG_BLK_DEV_NBD is not set

CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NTFS3_FS=m
# CONFIG_NTFS_FS is not set
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=m
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_EXT4_FS=m
# CONFIG_XFS_FS is not set
# CONFIG_F2FS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_ZONEFS_FS is not set

CONFIG_IGC=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_BT=m
CONFIG_BT_INTEL=m
CONFIG_BT_HCIBTUSB=m
CONFIG_NF_TABLES=y
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_WIREGUARD=m
CONFIG_TUN=m
CONFIG_IPV6=y
CONFIG_NETFILTER=y

CONFIG_KVM=m
CONFIG_KVM_INTEL=m
# CONFIG_KVM_AMD is not set
# Never Xen host/guest on this machine
# CONFIG_XEN is not set
# CONFIG_HYPERV is not set

CONFIG_X86_INTEL_LPSS=y
CONFIG_ASUS_WMI=m
CONFIG_ASUS_ARMOURY=m
CONFIG_SENSORS_ASUS_EC=m
CONFIG_ACPI_WMI=y
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y

CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
# Keychron K4 (Mac mode) presents as 05ac:024f → ONLY hid_apple binds.
# HID_QUIRK_HAVE_SPECIAL_DRIVER blocks hid-generic; if this is =m and the
# module is missing from initramfs, LUKS password prompt gets no keystrokes.
# Built-in so the default boot path never depends on mkinitcpio autodetect.
CONFIG_HID_APPLE=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_SND=y
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_USB_AUDIO=m
# SOF path is loaded for board HDA (snd_sof_pci_intel_tgl) even when playback
# is USB + NVIDIA HDMI — keep Intel SOF, drop AMD SOF
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF=m
CONFIG_SND_SOC_SOF_PCI=m
# CONFIG_SND_SOC_SOF_AMD_TOPLEVEL is not set
# CONFIG_SND_SOC_AMD_SOF_MACH is not set

CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_NTSYNC=y
