# Default target for this workstation installer (desktop variant).
# Server: use --variant server or see machine-server.env
# Override on the command line if needed.

APPSYNERGY_VARIANT=desktop
APPSYNERGY_DISK=/dev/nvme0n1
APPSYNERGY_HOSTNAME=appsynergy
APPSYNERGY_USER=appsynergy
APPSYNERGY_TIMEZONE=America/Sao_Paulo
APPSYNERGY_LOCALE=en_US.UTF-8
APPSYNERGY_KEYMAP=us
APPSYNERGY_EFI_SIZE=2G
# subvol=@ root; LUKS mapper name
APPSYNERGY_CRYPTNAME=cryptroot
# Kernel is always appsynergy-linux from /opt/appsynergy/pkgs. A CPU without
# x86-64-v3 is refused before any disk is touched.
# TPM2 LUKS enroll during install (1/true/yes = force; 0/false/no = skip; unset = auto if TPM present)
# APPSYNERGY_TPM=1
# APPSYNERGY_TPM_PCRS=7
