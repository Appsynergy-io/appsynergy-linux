# Default target for this workstation installer.
# Override on the command line if needed.

APPSYNERGY_DISK=/dev/nvme0n1
APPSYNERGY_HOSTNAME=appsynergy
APPSYNERGY_USER=imma
APPSYNERGY_TIMEZONE=America/Sao_Paulo
APPSYNERGY_LOCALE=en_US.UTF-8
APPSYNERGY_KEYMAP=us
APPSYNERGY_EFI_SIZE=2G
# subvol=@ root; LUKS mapper name
APPSYNERGY_CRYPTNAME=cryptroot
# Kernel source: repo | local
# local = install pkgs from /opt/appsynergy/pkgs/linux-cachyos-igpu*.pkg.tar.zst
APPSYNERGY_KERNEL=local
