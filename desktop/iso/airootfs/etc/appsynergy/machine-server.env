# Defaults for server variant (OVH / headless tunnel host).
# Selected when: appsynergy-install --variant server
# or APPSYNERGY_VARIANT=server

APPSYNERGY_VARIANT=server
# Dual Intel DC NVMe (e.g. 2× SSDPE2MX450G7): LUKS each + btrfs RAID1
# Override: --disks /dev/nvme0n1,/dev/nvme1n1  or single --disk /dev/sda
APPSYNERGY_DISKS=/dev/nvme0n1,/dev/nvme1n1
# APPSYNERGY_DISK=/dev/sda
APPSYNERGY_HOSTNAME=appsynergy-server
APPSYNERGY_USER=appsynergy
APPSYNERGY_TIMEZONE=UTC
APPSYNERGY_LOCALE=en_US.UTF-8
APPSYNERGY_KEYMAP=us
APPSYNERGY_EFI_SIZE=1G
APPSYNERGY_CRYPTNAME=cryptroot
APPSYNERGY_KERNEL=local
# Disk layout = desktop: full-disk LUKS2 + btrfs (@ @home @log @cache @snapshots).
# Unlock order: (1) TPM2 auto  (2) SSH dropbear in initrd + passphrase  (3) console.
# TPM: auto-enroll when TPM present. Force: APPSYNERGY_TPM=1. Skip: APPSYNERGY_TPM=0.
# SSH pubkey: baked at /etc/appsynergy/ssh-unlock.pub (existing imma@2048-host).
# Override only if needed: APPSYNERGY_SSH_PUBKEY=/path/to.pub
# APPSYNERGY_SSH_PUBKEY=

