#!/bin/sh
# Initramfs login shell for dropbear break-glass unlock (systemd initrd).
#
# Unlock order (see /etc/appsynergy/UNLOCK.txt on the installed system):
#   1) TPM2 token   — automatic, no SSH needed
#   2) this shell   — operator supplies the LUKS passphrase over SSH
#   3) console      — serial / IPMI / KVM
#
# Answers systemd-cryptsetup's outstanding password requests directly rather
# than via `systemd-tty-ask-password-agent --query`: that mode needs a
# controlling terminal it does not reliably get over dropbear, and fails with
# "Failed to send: No such file or directory". Replying to the ask sockets
# ourselves needs no TTY and handles several encrypted devices in one pass.
set -u

ASKDIR=/run/systemd/ask-password
REPLY_BIN=

for c in /usr/lib/systemd/systemd-reply-password /lib/systemd/systemd-reply-password; do
  [ -x "$c" ] && { REPLY_BIN=$c; break; }
done

echo "appsynergy-initrd-unlock: enter the LUKS passphrase to continue booting."
echo "appsynergy-initrd-unlock: verify the dropbear host key fingerprint out-of-band first."

# cryptsetup may still be starting; wait for at least one pending request.
n=0
while [ "$n" -lt 60 ]; do
  set -- "$ASKDIR"/ask.*
  [ -e "$1" ] && break
  n=$((n + 1))
  sleep 1
done

set -- "$ASKDIR"/ask.*
if [ ! -e "$1" ]; then
  echo "appsynergy-initrd-unlock: no pending password request."
  echo "  The disks may already be unlocked, or cryptsetup has not started yet."
  exit 1
fi

# Read the passphrase once and reuse it for every pending ask — all volumes on
# this host share the same passphrase slot.
if [ -t 0 ]; then
  stty -echo 2>/dev/null || true
  printf 'LUKS passphrase: '
  read -r pw
  stty echo 2>/dev/null || true
  echo
else
  read -r pw
fi

answered=0
failed=0
for f in "$ASKDIR"/ask.*; do
  [ -e "$f" ] || continue
  sock=$(sed -n 's/^Socket=//p' "$f" 2>/dev/null | head -1)
  [ -n "$sock" ] && [ -S "$sock" ] || continue
  if [ -n "$REPLY_BIN" ] && printf '%s' "$pw" | "$REPLY_BIN" 1 "$sock" 2>/dev/null; then
    answered=$((answered + 1))
  else
    failed=$((failed + 1))
  fi
done
unset pw

if [ "$answered" -gt 0 ]; then
  echo "appsynergy-initrd-unlock: answered $answered request(s); boot continues."
  [ "$failed" -gt 0 ] && echo "appsynergy-initrd-unlock: $failed request(s) unanswered."
  exit 0
fi

echo "appsynergy-initrd-unlock: could not answer any request (reply helper missing?)."
echo "  Fall back to the console passphrase."
exit 1
