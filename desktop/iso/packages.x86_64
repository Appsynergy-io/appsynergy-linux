# Live USB only — keep small. Target disk packages live in
# airootfs/etc/appsynergy/packages-target.txt (installed by appsynergy-install).

# base live
base
base-devel
linux
linux-headers
linux-firmware
sof-firmware
intel-ucode
mkinitcpio
mkinitcpio-archiso
syslinux
edk2-shell
memtest86+
memtest86+-efi

# install tooling
arch-install-scripts
gptfdisk
parted
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
btrfs-progs
cryptsetup
tpm2-tools
tpm2-tss
efibootmgr
pv
rsync
wget
curl
reflector
pacman-contrib

# network (installer needs net)
