/work/
# build scripts create timestamped work dirs (root-owned, several GB)
/work-iso-*/
/work-bootstrap-*/
/out/
/payload/
*.iso
iso/airootfs/opt/appsynergy/pkgs/*.pkg.tar.zst
iso/airootfs/opt/appsynergy/pkgs/*.pkg.tar.zst.sig
iso/airootfs/opt/appsynergy/pkgs/*.sig
# staged rescue CLIs (copied at ISO build from ~/.grok and ~/.bun)
iso/airootfs/usr/local/bin/grok
iso/airootfs/usr/local/bin/agent
iso/airootfs/usr/local/bin/claude
# staged k3s binary (scripts/stage-k3s.sh at ISO build)
iso/airootfs/opt/appsynergy/k3s/k3s
iso/airootfs/opt/appsynergy/k3s/VERSION
brand-review/candidates-all/
# k3s service env (0600, holds runtime secrets — never commit)
iso/airootfs/opt/appsynergy/k3s/k3s.service.env
