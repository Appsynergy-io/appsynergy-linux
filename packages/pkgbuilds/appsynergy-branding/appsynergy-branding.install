post_install() {
  gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
  _appsynergy_apply_os_release
  _appsynergy_plymouth
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
}

_appsynergy_plymouth() {
  # Prefer appsynergy theme when Plymouth is installed
  command -v plymouth-set-default-theme >/dev/null 2>&1 || return 0
  [[ -f /usr/share/plymouth/themes/appsynergy/appsynergy.plymouth ]] || return 0
  plymouth-set-default-theme appsynergy 2>/dev/null || true
  # rebuild initramfs so next boot shows the theme (best-effort)
  if command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P 2>/dev/null || true
  fi
}

_appsynergy_apply_os_release() {
  # Apply distro identity. Keep a one-time backup of the previous file.
  local src=/etc/appsynergy/os-release
  [[ -f $src ]] || return 0
  if [[ -f /usr/lib/os-release ]] && ! grep -q 'ID=appsynergy-linux' /usr/lib/os-release 2>/dev/null; then
    if [[ ! -f /etc/appsynergy/os-release.pre-appsynergy ]]; then
      cp -a /usr/lib/os-release /etc/appsynergy/os-release.pre-appsynergy 2>/dev/null || true
    fi
  fi
  cp -a "$src" /usr/lib/os-release
  # /etc/os-release is often a symlink to /usr/lib/os-release on Arch
  if [[ -e /etc/os-release && ! -L /etc/os-release ]]; then
    cp -a "$src" /etc/os-release
  fi
}
