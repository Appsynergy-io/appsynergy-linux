# Maintainer: AppSynergy
# Graphical identity — desktop installs only. Never pulled onto a server.
# Split out of appsynergy-branding 2-15 so wallpaper/icon/Plymouth iteration
# cannot force a package change (or an initramfs rebuild) on production servers.
pkgname=appsynergy-branding-desktop
pkgver=1
pkgrel=5
pkgdesc='AppSynergy Linux graphical identity: Plasma defaults, login and lock backgrounds, icons, Plymouth theme'
arch=('any')
url='https://github.com/Appsynergy-io/appsynergy-linux'
license=('MIT')
install=appsynergy-branding-desktop.install
# >=3 forces the identity split into the same pacman transaction; without it,
# upgrading separately hits file conflicts on paths branding 2-x used to own.
# qt6-declarative: the session splash is QML (plasma already pulls it on any desktop).
depends=('appsynergy-branding>=3' 'appsynergy-wallpapers' 'hicolor-icon-theme' 'qt6-declarative')
optdepends=('plymouth: animated boot splash (appsynergy theme)')
# Payload tarball generated by packages/scripts/make-srctars.sh (deterministic;
# regenerate + update sha256 when assets change). makepkg extracts it to $srcdir.
source=('branding-desktop-payload.tar')
sha256sums=('2052179e0764be146a31badaaba3e26f9de5cb6f262025c3d318b4b222e715f6')

package() {
  local src="${srcdir}"

  # hicolor icons — LOGO=appsynergy-linux / start = appsynergy-start
  # `[a]` on the dark pad, rendered from the spec in Geist by scripts/gen-icons.sh
  # (text converted to outlines). NOT hub-spoke.
  if [[ -d "$src/icons/hicolor" ]]; then
    while IFS= read -r -d '' f; do
      rel="${f#"$src/icons/"}"
      install -Dm644 "$f" "$pkgdir/usr/share/icons/$rel"
    done < <(find "$src/icons/hicolor" -type f -print0)
  fi
  # Alias so restored Kickoff configs that still say org.cachyos.hello show our mark
  if [[ -f "$pkgdir/usr/share/icons/hicolor/scalable/apps/appsynergy-start.svg" ]]; then
    ln -sfn appsynergy-start.svg \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.cachyos.hello.svg"
    for size in 16 22 24 32 48 64 128 256 512; do
      local d="$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
      if [[ -f "$d/appsynergy-start.png" ]]; then
        ln -sfn appsynergy-start.png "$d/org.cachyos.hello.png"
      fi
    done
  fi

  if [[ -f "$src/applications/appsynergy-start.desktop" ]]; then
    install -Dm644 "$src/applications/appsynergy-start.desktop" \
      "$pkgdir/usr/share/applications/appsynergy-start.desktop"
  fi

  # Plymouth theme: the logo master over a gliding hairline (scripts/gen-plymouth.sh)
  if [[ -d "$src/plymouth/appsynergy" ]]; then
    while IFS= read -r -d '' f; do
      rel="${f#"$src/plymouth/"}"
      install -Dm644 "$f" "$pkgdir/usr/share/plymouth/themes/$rel"
    done < <(find "$src/plymouth/appsynergy" -type f -print0)
  fi

  # Shipping the assets is not applying them: through 1-4 every install booted to
  # stock Breeze with Plasma's own wallpaper while ours sat unused on disk.
  #  - look-and-feel: Breeze Dark whose default wallpaper is AppSynergy. Only a
  #    default — selected by LookAndFeelPackage in the installer's skel kdeglobals,
  #    so a user who picks another wallpaper keeps it. Layout falls back to Breeze.
  #  - kscreenlockerrc: system-wide default lock background.
  #  - theme.conf.user: the override file SDDM's Breeze theme reads beside theme.conf.
  #  - layouts/: first-login panel — start button = appsynergy-start, no dead pins.
  #  - splash/: session splash matching the boot splash.
  #  - mimeapps.list: Brave is the default browser (web links, html).
  #  - kdeglobals / ksplashrc: system defaults under /etc/xdg (KConfig cascades, so
  #    they hold for every user without touching a home directory).
  local laf="look-and-feel/io.appsynergy.desktop"
  while IFS= read -r -d '' f; do
    rel="${f#"$src/lookandfeel/"}"
    install -Dm644 "$f" "$pkgdir/usr/share/plasma/look-and-feel/$rel"
  done < <(find "$src/lookandfeel/io.appsynergy.desktop" -type f -print0)
  [[ -f "$pkgdir/usr/share/plasma/$laf/contents/defaults" ]]
  for f in kscreenlockerrc kdeglobals ksplashrc mimeapps.list; do
    install -Dm644 "$src/xdg/$f" "$pkgdir/etc/xdg/$f"
  done
  install -Dm644 "$src/sddm/theme.conf.user" \
    "$pkgdir/usr/share/sddm/themes/breeze/theme.conf.user"

  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/appsynergy-branding-desktop/LICENSE"
}
