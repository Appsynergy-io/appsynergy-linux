post_install() {
  gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
  _appsynergy_plymouth
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
}

_appsynergy_plymouth() {
  # Prefer appsynergy theme when Plymouth is installed
  command -v plymouth-set-default-theme >/dev/null 2>&1 || return 0
  [[ -f /usr/share/plymouth/themes/appsynergy/appsynergy.plymouth ]] || return 0
  plymouth-set-default-theme appsynergy 2>/dev/null || true
  # rebuild initramfs so next boot shows the theme (best-effort)
  if command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P 2>/dev/null || true
  fi
}
