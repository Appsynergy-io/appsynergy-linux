# Maintainer: AppSynergy
# Desktop and lock wallpapers as KDE wallpaper packages, so nothing on a running
# machine ever points at a path inside a developer checkout.
#
# Provenance:
#   images/appsynergy-{1920x1200,3840x2400}.png
#     = desktop/brand-review/candidates-v3/H-desktop-procedural-lifted-*.png ("v3-H")
#   images/appsynergy-lock-3840x2400.png
#     = the lock render previously hand-placed in ~/.local/share/wallpapers/
# Re-pick from desktop/brand-review/, copy in, bump pkgrel.
pkgname=appsynergy-wallpapers
pkgver=1
pkgrel=4
pkgdesc='AppSynergy Linux wallpapers (desktop + lock) as KDE wallpaper packages'
arch=('any')
url='https://github.com/Appsynergy-io/appsynergy-linux'
license=('MIT')
# Payload tarball generated by packages/scripts/make-srctars.sh (deterministic;
# regenerate + update sha256 when assets change). makepkg extracts it to $srcdir.
source=('wallpapers-payload.tar')
sha256sums=('a0b64cee7f09207008b895b9c85c19ac2d3652361f9ada1d191bcf94acca03f8')

package() {
  local src="${srcdir}"
  local wp="$pkgdir/usr/share/wallpapers"

  # Desktop — both masters; Plasma picks per-screen by resolution.
  install -Dm644 "$src/metadata-desktop.json" "$wp/AppSynergy/metadata.json"
  install -Dm644 "$src/images/appsynergy-1920x1200.png" \
    "$wp/AppSynergy/contents/images/1920x1200.png"
  install -Dm644 "$src/images/appsynergy-3840x2400.png" \
    "$wp/AppSynergy/contents/images/3840x2400.png"

  # Lock / login
  install -Dm644 "$src/metadata-lock.json" "$wp/AppSynergy-Lock/metadata.json"
  install -Dm644 "$src/images/appsynergy-lock-3840x2400.png" \
    "$wp/AppSynergy-Lock/contents/images/3840x2400.png"

  install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/appsynergy-wallpapers/LICENSE"
}
