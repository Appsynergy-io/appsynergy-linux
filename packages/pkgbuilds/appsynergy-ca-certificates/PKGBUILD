# Maintainer: AppSynergy
# Trust anchors for the AppSynergy PKI (both variants, desktop and server).
# Certificates are PUBLIC material, exported from vault-k2 pki_int/ca_chain.
#
# Issuance policy (docs/DISTRO-AUDIT.md S1): end-entity certs are issued from
# the Intermediate only; the Root signs nothing operational.
#
# The Root is the ONLY anchor. The Intermediate installs to the trust-source
# top level, never anchors/: update-ca-trust(8) gives plain PEM there neutral
# trust — known to the system for chain construction, trusted for nothing. That
# keeps verification working against services presenting only their leaf
# (vault-k2 does) while a compromised Intermediate stays revocable under the
# same Root instead of being a second, independent trust root.
pkgname=appsynergy-ca-certificates
pkgver=1
pkgrel=3
pkgdesc='AppSynergy Root CA trust anchor; Intermediate CA as chain filler'
arch=('any')
url='https://git.appsynergy.io/imabee/appsynergy-linux'
license=('MIT')
depends=('ca-certificates-utils')
install=appsynergy-ca-certificates.install
source=('appsynergy-root-ca.crt' 'appsynergy-intermediate-ca.crt' 'LICENSE')
sha256sums=('457887042b024d7b445d1c25cbfdbd294066183b6b3f8b62320768dc8d1639d1'
            'a8a7e2d3dfda6f0842ff491d5eeb210a49775bf47753a2b6de8eb25eb81707b4'
            '34ac2e1db0fdddd3ff94d39eb16922f92a6dc7fd5e74843ac26e619b3ea73e99')

package() {
  install -Dm644 "$srcdir/appsynergy-root-ca.crt" \
    "$pkgdir/etc/ca-certificates/trust-source/anchors/appsynergy-root-ca.crt"
  install -Dm644 "$srcdir/appsynergy-intermediate-ca.crt" \
    "$pkgdir/etc/ca-certificates/trust-source/appsynergy-intermediate-ca.crt"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/appsynergy-ca-certificates/LICENSE"
}
