# Maintainer: AppSynergy
pkgname=appsynergy-mirrorlist
pkgver=1
pkgrel=6
pkgdesc='Pacman mirrorlist / repo registration for AppSynergy Linux packages'
arch=('any')
url='https://git.appsynergy.io/imabee/appsynergy-linux'
license=('MIT')
# Keyring in the same transaction: its .install populates pacman-key before our
# scriptlet migrates a legacy TrustAll section to Required.
depends=('appsynergy-keyring')
install=appsynergy-mirrorlist.install
source=('appsynergy-mirrorlist' 'appsynergy.conf' 'LICENSE')
sha256sums=('1808ff9fa3b6e1d6d2dbd9d8cf044555c5542ba86c97f8c33c899e7265475fa8'
            '8777a8c39de70ae0559ea0facc5387ae2f5b3910e6c0b7c41f01db4463592e99'
            '34ac2e1db0fdddd3ff94d39eb16922f92a6dc7fd5e74843ac26e619b3ea73e99')

package() {
  install -Dm644 "$srcdir/appsynergy-mirrorlist" \
    "$pkgdir/etc/pacman.d/appsynergy-mirrorlist"
  install -Dm644 "$srcdir/appsynergy.conf" \
    "$pkgdir/etc/pacman.conf.d/appsynergy.conf"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/appsynergy-mirrorlist/LICENSE"
}
