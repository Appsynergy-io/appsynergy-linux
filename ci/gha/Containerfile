# Optional GitHub Actions image for appsynergy-linux.
# ci.yml uses archlinux:latest and pacman -Syu
# each run. Pin this image later as ghcr.io/appsynergy-io/appsynergy-linux-ci:<tag>.
#
# Jobs must run as uid 1000 `build`: makepkg refuses root.
# Digest is the one .github/workflows/ci.yml runs on; Dependabot (docker, /ci/gha)
# bumps it here and check.sh stage ci-image fails until ci.yml matches.
FROM archlinux:base-devel@sha256:624bdc7fc6615155d67bc34cf7146c0c9fd0e3c92943977da63a630e4ca49c30

RUN pacman -Syu --noconfirm --needed \
      base-devel git shellcheck namcap rustup nodejs curl sudo \
      github-cli gnupg \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

RUN groupadd -g 1000 build \
 && useradd -u 1000 -g 1000 -m -d /home/build -s /bin/bash build

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/usr/local/bin:/usr/bin
RUN mkdir -p /opt/rustup /opt/cargo \
 && rustup toolchain install stable --profile minimal --no-self-update \
 && rustup default stable \
 && rustup component add rustfmt clippy \
 && chmod -R a+rX /opt/rustup /opt/cargo

USER build
WORKDIR /work
