# Gitea act_runner image for aarch64-apple-darwin (OSXCross) CI on OVH k3s.
#
# Same security/runtime posture as ci/runner: host exec mode, uid 1000, no docker.
# MacOSX SDK is supplied at image build time only (from the LAN MacBook package);
# it is baked into the private image and never re-fetched at job time.
#
# Build (from repo root; SDK tarball must exist under ci/runner-osxcross/sdk/):
#   podman build -t git.appsynergy.io/imabee/appsynergy-ci-osxcross:0.1.0 ci/runner-osxcross

# ---------------------------------------------------------------------------
# Stage 1: build OSXCross against the packaged MacOSX SDK
# ---------------------------------------------------------------------------
FROM archlinux:latest AS osxcross-build

RUN pacman -Syu --noconfirm --needed \
      base-devel git clang cmake python openssl xz libxml2 cpio patch \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

# Pin OSXCross for reproducible toolchain builds.
ARG OSXCROSS_REF=master
WORKDIR /src
RUN git clone --depth 1 https://github.com/tpoechtrager/osxcross.git \
 && cd osxcross && git rev-parse HEAD > /osxcross.rev

# SDK tarball(s) must be present in the build context under sdk/.
# Produced once on the MacBook via gen_sdk_package.sh (or fallback tar).
COPY sdk/ /src/osxcross/tarballs/

WORKDIR /src/osxcross
# UNATTENDED skips prompts; OSX_VERSION_MIN keeps a usable deployment target
# for aarch64-apple-darwin. TARGET_DIR installs outside the build tree.
ENV UNATTENDED=1 \
    OSX_VERSION_MIN=11.0 \
    TARGET_DIR=/opt/osxcross
RUN ./build.sh \
 && /opt/osxcross/bin/oa64-clang --version \
 && ls /opt/osxcross/SDK

# ---------------------------------------------------------------------------
# Stage 2: runtime runner image
# ---------------------------------------------------------------------------
FROM archlinux:latest

# clang is required at runtime: oa64-clang is a wrapper that execs host clang
# with -target arm64-apple-darwin* and the baked SDK sysroot.
RUN pacman -Syu --noconfirm --needed \
      base-devel git rustup nodejs curl ca-certificates cmake ninja python \
      clang llvm \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

ARG ACT_RUNNER_VERSION=0.2.13
ARG ACT_RUNNER_SHA256=3acac8b506ac8cadc88a55155b5d6378f0fab0b8f62d1e0c0450f4ccd69733e2
RUN curl -fsSL -o /tmp/act_runner \
      "https://dl.gitea.com/act_runner/${ACT_RUNNER_VERSION}/act_runner-${ACT_RUNNER_VERSION}-linux-amd64" \
 && printf '%s  /tmp/act_runner\n' "${ACT_RUNNER_SHA256}" | sha256sum -c - \
 && install -Dm755 /tmp/act_runner /usr/local/bin/act_runner \
 && rm -f /tmp/act_runner

RUN groupadd -g 1000 build \
 && useradd -u 1000 -g 1000 -m -d /home/build -s /bin/bash build

# OSXCross toolchain + SDK (read-only at runtime under the image layers).
COPY --from=osxcross-build /opt/osxcross /opt/osxcross
# Stable SDKROOT: OSXCross keeps SDKs under /opt/osxcross/SDK/MacOSX*.sdk
RUN SDK="$(echo /opt/osxcross/SDK/MacOSX*.sdk)" \
 && test -d "$SDK" \
 && ln -sfn "$SDK" /sdk \
 && test -x /opt/osxcross/bin/oa64-clang

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/osxcross/bin:/usr/local/bin:/usr/bin \
    SDKROOT=/sdk \
    MACOSX_DEPLOYMENT_TARGET=11.0 \
    CC_aarch64_apple_darwin=oa64-clang \
    CXX_aarch64_apple_darwin=oa64-clang++ \
    CARGO_TARGET_AARCH64_APPLE_DARWIN_LINKER=oa64-clang

RUN mkdir -p /opt/rustup /opt/cargo \
 && rustup toolchain install stable --profile minimal --no-self-update \
 && rustup default stable \
 && rustup target add aarch64-apple-darwin \
 && chmod -R a+rX /opt/rustup /opt/cargo /opt/osxcross /sdk

COPY entrypoint.sh /usr/local/bin/act-runner-entrypoint
RUN chmod 0755 /usr/local/bin/act-runner-entrypoint

USER build
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/act-runner-entrypoint"]
