# Gitea act_runner image for appsynergy-linux CI.
#
# Jobs execute in HOST exec mode inside this pod's own Arch userland — k3s is the
# only runtime here, so there is no docker daemon and no container-in-container.
# Consequence: every dependency scripts/check.sh needs must be baked in, and the
# workflow cannot install anything (uid 1000, no sudo, read-only rootfs at run time).
#
# Dependency list is derived from scripts/check.sh, stage by stage:
#   1 shellcheck        -> shellcheck
#   2 cargo test        -> rustup + stable toolchain (owned by `build`)
#   3 tarball-sums      -> tar/sha256sum/sed (coreutils, base)
#   4 makepkg -f -d     -> base-devel (fakeroot, binutils, findutils, file); `-d`
#                          skips dep resolution, so runtime depends() of the any/
#                          packages are deliberately NOT installed
#   5 namcap            -> namcap (pulls python/pyalpm)
#   6 kernel-pin        -> git (no-ops: no kernel tree in the pod)
# Plus: git + nodejs for actions/checkout@v4 — a JS action, which host mode runs
# with the node binary on PATH; without it every job fails at checkout.
#
# archlinux:latest is a moving base by design: the gate must build against current
# Arch, the same target the packages ship to. Rebuild the image to move it.
FROM archlinux:latest

RUN pacman -Syu --noconfirm --needed \
      base-devel git shellcheck namcap rustup nodejs curl ca-certificates \
 && pacman -Scc --noconfirm \
 && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*

# act_runner 0.2.13, pinned by version AND published sha256.
# binary: https://dl.gitea.com/act_runner/0.2.13/act_runner-0.2.13-linux-amd64
# sha256: https://dl.gitea.com/act_runner/0.2.13/act_runner-0.2.13-linux-amd64.sha256
ARG ACT_RUNNER_VERSION=0.2.13
ARG ACT_RUNNER_SHA256=3acac8b506ac8cadc88a55155b5d6378f0fab0b8f62d1e0c0450f4ccd69733e2
RUN curl -fsSL -o /tmp/act_runner \
      "https://dl.gitea.com/act_runner/${ACT_RUNNER_VERSION}/act_runner-${ACT_RUNNER_VERSION}-linux-amd64" \
 && printf '%s  /tmp/act_runner\n' "${ACT_RUNNER_SHA256}" | sha256sum -c - \
 && install -Dm755 /tmp/act_runner /usr/local/bin/act_runner \
 && rm -f /tmp/act_runner

# uid/gid 1000 must equal runAsUser/runAsGroup and fsGroup in the Deployment:
# the PVCs are group-owned by 1000 and makepkg refuses to run as root.
RUN groupadd -g 1000 build \
 && useradd -u 1000 -g 1000 -m -d /home/build -s /bin/bash build

# Toolchain lives outside HOME and outside CARGO_HOME so neither the read-only
# rootfs nor the cargo-cache PVC mount can hide the rustup proxies at run time.
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin
RUN rustup --version >/dev/null \
 && rustup toolchain install stable --profile minimal --no-self-update \
 && rustup default stable \
 && chmod -R a+rX /opt/rustup /opt/cargo \
 && ln -sf /opt/cargo/bin/cargo /opt/cargo/bin/rustc /opt/cargo/bin/rustup /usr/local/bin/

COPY entrypoint.sh /usr/local/bin/act-runner-entrypoint
RUN chmod 0755 /usr/local/bin/act-runner-entrypoint

# CARGO_HOME is repointed at the writable cache PVC by the Deployment; RUSTUP_HOME
# stays on the read-only image layer (running an installed toolchain never writes it).
USER build
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/act-runner-entrypoint"]
